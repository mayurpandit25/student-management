pipeline {
    agent {
        label "worker"
    }

    environment {
        my_aws_credentials = credentials('aws-access')
    }

    tools {
        maven "maven"
    }

    stages {
        stage('checkout'){
            steps {
                git 'https://github.com/mayurpandit25/student-management.git'
                sh '''
                echo "clonning is successful"
                '''
            }
        }

        stage('Build'){
            steps {
                sh '''
                mvn clean package
                echo "build is successful"
                '''
            }
            post {
                success {
                    archiveArtifacts artifacts: '**/target/*.war', fingerprint: true
                }
            }
        }

        stage('Artifact to S3'){
            steps {
                sh '''
                aws s3 cp target/*.war s3://mayurcbz.space/Artifact/student.war
                '''
            }
        }
    }
}