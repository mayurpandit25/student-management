pipeline {
    agent {
        label "worker"
    }

    environment {
        my_aws_credentials = credentials('aws-access')
    }

    tools {
        maven "maven"
    }

    stages {
        stage('checkout'){
            steps {
                git 'https://github.com/mayurpandit25/student-management.git'
                sh '''
                echo "clonning is successful"
                '''
            }
        }

        stage('Build'){
            steps {
                sh '''
                mvn clean package
                echo "build is successful"
                '''
            }
            post {
                success {
                    archiveArtifacts artifacts: '**/target/*.war', fingerprint: true
                }
            }
        }

        stage('Artifact to S3'){
            steps {
                sh '''
                aws s3 cp target/*.war s3://mayurcbz.space/Artifact/student.war
                '''
            }
        }

        stage('SonarQube Analysis'){
            steps {
                withSonarQubeEnv('sonar') {
                  sh 'mvn sonar:sonar'
                } 
            }
        }

        stage('SonarQube Quality Gates'){
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Docker Build'){
            steps {
                sh '''
                docker build -t student:latest .
                docker images
                '''
            }
        }

        stage('Push Image To ECR'){
            steps {
                sh '''
                aws ecr get-login-password --region us-east-2 | docker login --username AWS --password-stdin 942049393829.dkr.ecr.us-east-2.amazonaws.com
                docker tag student:latest 942049393829.dkr.ecr.us-east-2.amazonaws.com/student:latest
                docker push 942049393829.dkr.ecr.us-east-2.amazonaws.com/student:latest
                '''
            }
        }

        stage('deploy to kubernetes'){
            steps {
                sh '''
                aws eks update-kubeconfig --name my-cluster-eks --region us-east-2
                kubectl apply -f k8s/student-deploy.yaml
                kubectl apply -f k8s/student-svc.yaml
                kubectl get pods
                kubectl get svc
                sleep 30 
                kubectl get pods
                kubectl get svc -o wide
                '''
            }
        }
    }

    post{
        success{
            sh '''
            echo 'Pipeline is successful'
            '''
        }
        failure{
            echo 'Pipeline is failed'
        }
    }
}




